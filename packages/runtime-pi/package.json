{
  "name": "@heyo-sh/code-audit-runtime-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@heyo-sh/code-audit-core": "workspace:*",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "typebox": "1.4.3"
  }
}
